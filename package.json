{
  "name": "dsh-fff",
  "version": "0.1.0",
  "description": "DeepSeek Harness plugin: FFF-powered fuzzy file find + content grep (port of @ff-labs/pi-fff / fff-mcp).",
  "type": "module",
  "main": "index.js",
  "exports": { ".": "./index.js", "./package.json": "./package.json" },
  "files": [
    "index.js",
    "lib",
    "cordis.patch.yml",
    "patches",
    "README.md",
    "README.zh-CN.md",
    "LICENSE",
    "FEATURE_MAP.md"
  ],
  "scripts": { "test": "node --test test/*.test.js" },
  "keywords": ["deepseek-harness", "dsh", "dsh-plugin", "cordis", "fff", "grep", "find", "fuzzy"],
  "license": "MIT",
  "engines": { "node": ">=20.0.0" },
  "dsh": {
    "engines": { "dsh": ">=0.2.0-rc.1" },
    "bundle": { "patch": "./cordis.patch.yml" }
  },
  "dependencies": {
    "@ff-labs/fff-node": "^0.11.0"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": ">=0.2.0-rc.2",
    "@deepseek-ai/schemastery": "^3.18.0"
  },
  "devDependencies": {
    "@deepseek-ai/schemastery": "^3.18.4"
  }
}
